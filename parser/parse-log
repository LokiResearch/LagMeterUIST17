import os
import argparse

from matplotlib.backends.backend_pdf import PdfPages
from matplotlib import pyplot

from LogFile import LogFile

parser = argparse.ArgumentParser()
parser.add_argument('-d', '--dump', action='store_true', help="dump log file in console")
parser.add_argument('-e', '--export', action='store_true', help="export plot as PDF")
parser.add_argument('--start', default=None, help="first observation point to take into account")
parser.add_argument("logfile", nargs="+")
args = parser.parse_args()

if len(args.logfile)>1:
    pdf = PdfPages("lag-distributions.pdf")
    logs = [LogFile(path, args.start) for path in args.logfile]
    minlag = min([log.stats.minvalue for log in logs])
    maxlag = max([log.stats.maxvalue for log in logs])
    for log in logs:
        fig = log.plot("%s (%d blocks)"%(os.path.basename(log.path), len(log.stats.blocks)),
                       minlag=minlag, maxlag=maxlag)
        pdf.savefig(fig, dpi=600)
        del fig
    pdf.close()
else:
    log = LogFile(args.logfile[0], args.start)
    if args.dump: log.dump()
    fig = log.plot(title="%s (%d blocks)"%(os.path.basename(log.path), len(log.stats.blocks)))
    if args.export:
        root, ext = os.path.splitext(args.logfile[0])
        pdf = PdfPages(root+".pdf")
        pdf.savefig(fig, dpi=600)
        pdf.close()        
    pyplot.show()
